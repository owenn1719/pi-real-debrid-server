+
+func TestRmdir501IsMissing(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		enabled string
+		wantErr bool
+	}{
+		{name: "disabled", enabled: "false", wantErr: true},
+		{name: "enabled", enabled: "true", wantErr: false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method == "PROPFIND" {
+					w.WriteHeader(http.StatusNotImplemented)
+					return
+				}
+				w.WriteHeader(http.StatusNoContent)
+			}))
+			defer ts.Close()
+
+			configfile.Install()
+			m := configmap.Simple{
+				"type":                 "webdav",
+				"url":                  ts.URL,
+				"rmdir_501_is_missing": test.enabled,
+			}
+			f, err := webdav.NewFs(context.Background(), remoteName, "", m)
+			require.NoError(t, err)
+
+			err = f.Rmdir(context.Background(), "already-gone")
+			if test.wantErr {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), "501")
+			} else {
+				require.NoError(t, err)
+			}
+		})
+	}
+}
